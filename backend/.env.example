# ==========================================
# 1. LiveKit Cloud Configuration
# ==========================================
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==========================================
# 2. AI Pipeline Providers (STT / LLM / TTS)
# ==========================================
# Deepgram STT (Korean optimized)
DEEPGRAM_API_KEY=your_deepgram_api_key

# Google Gemini LLM (gemini-2.5-flash)
GOOGLE_API_KEY=your_google_gemini_api_key

# ElevenLabs TTS (eleven_flash_v2_5, benevolent grandfather voice)
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=your_santa_voice_id_or_default

# ==========================================
# 3. Real-time Avatar Provider Factory
# ==========================================
# Options: "anam" (default, free tier available) | "lemonslice" | "heygen"
AVATAR_PROVIDER=anam

# [Default] Anam (Real-time Persona Avatar via livekit-plugins-anam)
ANAM_API_KEY=your_anam_api_key
ANAM_AVATAR_ID=your_anam_santa_avatar_id

# [Option A] LemonSlice (Single-photo real-time lip-sync)
LEMONSLICE_API_KEY=your_lemonslice_api_key
LEMONSLICE_AVATAR_ID=your_lemonslice_santa_avatar_id
LEMONSLICE_AGENT_IMAGE_URL=https://your-cdn.example.com/santa-portrait.jpg

# [Option B] HeyGen LiveAvatar (Lite mode via livekit-plugins-liveavatar)
LIVEAVATAR_API_KEY=your_heygen_liveavatar_api_key
HEYGEN_API_KEY=your_heygen_api_key_fallback
LIVEAVATAR_AVATAR_ID=your_heygen_santa_avatar_id
