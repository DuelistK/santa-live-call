# ==========================================
# LiveKit Cloud Credentials (Server & Client)
# ==========================================
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==========================================
# Optional: Gemini API Key for Frontend Fallback Gift Summary
# ==========================================
GOOGLE_API_KEY=your_google_gemini_api_key

# ==========================================
# Avatar Provider Display Hint ("anam" | "lemonslice" | "heygen")
# ==========================================
NEXT_PUBLIC_AVATAR_PROVIDER=anam
